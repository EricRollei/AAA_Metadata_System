# ExifTool config for the AAA_Metadata_System v2 custom namespace.
# Prefix: hcai   URI: http://historic.camera/ns/ai/2.0/
# Usage: exiftool -config exiftool_hcai.config ...

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        hcai => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::hcai' },
        },
    },
);

%Image::ExifTool::UserDefined::hcai = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-hcai', 2 => 'Image' },
    NAMESPACE => { 'hcai' => 'http://historic.camera/ns/ai/2.0/' },
    WRITABLE  => 'string',
    Model          => { },
    Prompt         => { },
    NegativePrompt => { },
    RecordJSON     => { },
);

1;
